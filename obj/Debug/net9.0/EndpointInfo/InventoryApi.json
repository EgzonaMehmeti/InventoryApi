            "minLength": 3,
            "type": "string"
          },
          "description": {
            "maxLength": 1000,
            "type": "string",
            "nullable": true
          },
          "price": {
            "maximum": 10000000000000000,
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "quantityInStock": {
            "maximum": 2147483647,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          },
          "category": {
            "maxLength": 100,
